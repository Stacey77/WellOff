# WellOff AI Platform Environment Variables

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key

# Milvus Configuration
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=welloff_vectors

# n8n Configuration
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_PATH=/webhook
N8N_API_KEY=your-n8n-api-key

# Voice Configuration
VOICE_LANGUAGE=en-US
TTS_VOICE=default

# Application Settings
DEBUG=false
HOST=0.0.0.0
PORT=8000
# ─── WellOff environment variables ──────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored; never commit secrets.

# ── Kimi / Moonshot AI ───────────────────────────────────────────────────────
# Required: one of the two API key vars must be set to use the Kimi provider.
MOONSHOT_API_KEY=           # preferred — Moonshot AI platform key
OPENAI_API_KEY=             # fallback when MOONSHOT_API_KEY is absent

# Optional overrides (defaults shown):
KIMI_MODEL=kimi-k2                          # model ID passed to the API
KIMI_BASE_URL=https://api.moonshot.cn/v1    # must stay on the allowlist
