# ─── WellOff environment variables ──────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored; never commit secrets.

# ── Kimi / Moonshot AI ───────────────────────────────────────────────────────
# Required: one of the two API key vars must be set to use the Kimi provider.
MOONSHOT_API_KEY=           # preferred — Moonshot AI platform key
OPENAI_API_KEY=             # fallback when MOONSHOT_API_KEY is absent

# Optional overrides (defaults shown):
KIMI_MODEL=kimi-k2                          # model ID passed to the API
KIMI_BASE_URL=https://api.moonshot.cn/v1    # must stay on the allowlist
