# Copy to .env (deploy.ps1 / deploy.sh do this for you and generate the key).
EMPIRE_ADMIN_KEY=          # operator key, sent as X-API-Key. Long and random.
EMPIRE_PORT=8080           # host port for the API
EMPIRE_LLM=ollama          # ollama | rule (rule = offline planner, no model)
EMPIRE_MODEL=llama3.1:8b   # any model Ollama can pull
EMPIRE_SCALING_INTERVAL=2  # seconds between autoscaler ticks; 0 = manual
GITEA_BASE_URL=http://localhost:3000
